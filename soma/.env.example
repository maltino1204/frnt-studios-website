# =============================================================================
# SOMA — environment variables (copy to .env.local; never commit real secrets)
# All values below are safe local placeholders.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Public base URL (links in e-mails, referral/invite links, Stripe return URLs).
# Set it in every deployed environment. Only in development, when APP_URL is unset,
# links are derived from the request host (so a server on :3100 never links to :3000).
APP_URL=http://localhost:3000

# Client IP for the login / auth-e-mail limits — trusted only when configured explicitly.
# TRUSTED_IP_HEADER: a header your platform overwrites with the client IP, e.g.
#   x-vercel-forwarded-for (Vercel), cf-connecting-ip (Cloudflare), x-real-ip (nginx with proxy_set_header).
# TRUSTED_PROXY_HOPS: alternatively, the number of proxies appending to X-Forwarded-For
#   (the N-th entry from the right is used). With neither, no client header is used
#   (per-e-mail limits + global failure budget only) and `npm run check:launch` blocks.
TRUSTED_IP_HEADER=
TRUSTED_PROXY_HOPS=0

# Shows the "Demo-Umgebung · Beispieldaten" ribbon; required (=true) for `npm run db:seed`.
# Demo logins after seeding (password soma-demo-2026): testkunde@soma.test (customer),
# testkunde-b2b@soma.test (provider), testadmin@soma.test (admin). Never true in production.
DEMO_MODE=true

# --- Database ----------------------------------------------------------------
# Local: any Postgres >= 15 (role must own the schema). Supabase: the pooler
# connection string in *transaction* mode (port 6543) — then set DATABASE_PREPARE=false.
DATABASE_URL=postgres://soma:soma@localhost:5432/soma
# Pool size per server instance
DATABASE_POOL_MAX=10
# Prepared statements (set to false behind PgBouncer / Supabase transaction pooler)
DATABASE_PREPARE=true
# Integration tests (database name must end with _test; it is reset on every run)
TEST_DATABASE_URL=postgres://soma:soma@localhost:5432/soma_test

# --- Adapters ----------------------------------------------------------------
# local = scrypt + DB sessions (dev, fully working) | supabase = Supabase Auth
AUTH_PROVIDER=local
# dev = "Testmodus" simulator | stripe = Stripe Connect Express (manual capture)
PAYMENTS_PROVIDER=dev
# local = files under UPLOAD_DIR served via /api/media | supabase = Supabase Storage
STORAGE_PROVIDER=local
# dev = email_outbox + console | resend = Resend API
EMAIL_PROVIDER=dev

# Local upload directory (relative to the project root; gitignored)
UPLOAD_DIR=.data/uploads

# --- Cron --------------------------------------------------------------------
# Bearer token for POST/GET /api/cron/booking-maintenance (min. 16 characters)
CRON_SECRET=change-me-local-cron-secret

# --- Supabase (AUTH_PROVIDER=supabase and/or STORAGE_PROVIDER=supabase) ------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key-placeholder
# Server only — used by the storage adapter, never sent to the browser
SUPABASE_SERVICE_ROLE_KEY=service-role-key-placeholder

# --- Stripe (PAYMENTS_PROVIDER=stripe) ----------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# Signing secret of the /api/webhooks/stripe endpoint
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- E-mail (EMAIL_PROVIDER=resend) -------------------------------------------
RESEND_API_KEY=re_placeholder
EMAIL_FROM="SOMA <hallo@soma.example>"
