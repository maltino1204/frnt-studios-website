{
  "name": "soma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:setup": "tsx scripts/db/setup.ts",
    "db:reset": "tsx scripts/db/setup.ts --reset",
    "db:seed": "tsx --conditions=react-server scripts/db/seed.ts",
    "demo:refresh": "tsx --conditions=react-server scripts/db/demo-refresh.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "images:fetch": "node scripts/images/fetch.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "prebuild": "node scripts/images/fetch.mjs || true"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.14",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.11"
  }
}
